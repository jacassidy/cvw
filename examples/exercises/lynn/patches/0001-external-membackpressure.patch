diff --git a/src/ComputeCore.sv b/src/ComputeCore.sv
index ea73af5..18839be 100644
--- a/src/ComputeCore.sv
+++ b/src/ComputeCore.sv
@@ -18,7 +18,14 @@ module computeCore #(
     output  logic[`XLEN-1:0]       External_MemWriteData,   //Memory to be saved
 
     input   logic[`WORD_SIZE-1:0]  External_Instr,
-    input   logic[`XLEN-1:0]       External_MemReadData
+    input   logic[`XLEN-1:0]       External_MemReadData,
+
+    // External memory backpressure. When asserted (active high) the memory
+    // access in the M stage has not completed (e.g. a data-cache miss refill).
+    // The whole single-cycle core is held: the PC does not advance and no
+    // architectural state (register file, CSRs, minstret retirement) commits.
+    // Tie to 1'b0 for the original direct-memory (uncached) wrapper.
+    input   logic                  External_MemStall
 );
 
 
@@ -140,6 +147,7 @@ module computeCore #(
     _IStage IStage (
         .clk, .reset,
         .PCNext_I,
+        .External_MemStall,
     `ifdef PIPELINED
         .StallPC,
     `endif
@@ -183,7 +191,9 @@ module computeCore #(
         .clk, .reset,
         .Instr_R, .PC_R, .PCp4_R, .ValidInstruction_R,
 
-        .RegWrite_W,
+        // Gate the register-file write while a memory access is outstanding so
+        // the stalled instruction does not commit its result more than once.
+        .RegWrite_W(RegWrite_W & ~External_MemStall),
         .rd1Adr_W,
         .Rd1_W,
 
@@ -283,7 +293,12 @@ module computeCore #(
         .RegWrite_C, .ResultSrc_C, .TruncType_C,
 
     `ifdef ZICSR
-        .CSREn_C, .CSROp_C,
+        // CSR instructions never access data memory, so they never trigger a
+        // cache-miss stall: CSREn_C is already 0 whenever External_MemStall is
+        // asserted. Gating it here would add a redundant combinational path from
+        // the cache's Stall back into the C stage (a false UNOPTFLAT loop), so
+        // it is intentionally left ungated.
+        .CSREn_C(CSREn_C), .CSROp_C,
     `endif
 
     `ifdef PIPELINED
@@ -293,7 +308,8 @@ module computeCore #(
     `endif
 
     `ifdef ZICNTR
-        .ValidInstruction_W,
+        // Gate retirement so minstret counts the stalled instruction exactly once.
+        .ValidInstruction_W(ValidInstruction_W & ~External_MemStall),
     `endif
         .AluResult_C,
         .PCSrcPostConditional_C,
