diff --git a/src/_Stages/1_Instruction/_IStage.sv b/src/_Stages/1_Instruction/_IStage.sv
index 6948462..2aaed15 100644
--- a/src/_Stages/1_Instruction/_IStage.sv
+++ b/src/_Stages/1_Instruction/_IStage.sv
@@ -8,6 +8,9 @@ module _IStage (
 
     input  logic [`XLEN-1:0]        PCNext_I,
 
+    // Hold the PC while an external memory access is outstanding (cache miss).
+    input  logic                    External_MemStall,
+
 `ifdef PIPELINED
     input  logic                    StallPC,
 `endif
@@ -24,22 +27,28 @@ module _IStage (
 );
 
     logic [`XLEN-1:0] PROGRAM_ENTRY_ADR;
+`ifdef SYNTHESIS
+    // Synthesis: the reset entry point is a constant (0). The plusarg override
+    // is simulation-only; $value$plusargs is not synthesizable.
+    assign PROGRAM_ENTRY_ADR = '0;
+`else
     initial begin
         PROGRAM_ENTRY_ADR = '0; // default
         void'($value$plusargs("ENTRY_ADDR=%h", PROGRAM_ENTRY_ADR)); // override if provided
         $display("[TB] ENTRY_ADDR = 0x%h", PROGRAM_ENTRY_ADR);
     end
+`endif
 
     //Program Counter
     `ifdef PIPELINED
         always_ff @( posedge clk ) begin
-            if (reset)          PC_I <= PROGRAM_ENTRY_ADR;
-            else if (~StallPC)  PC_I <= PCNext_I;
+            if (reset)                            PC_I <= PROGRAM_ENTRY_ADR;
+            else if (~StallPC & ~External_MemStall) PC_I <= PCNext_I;
         end
     `else
         always_ff @( posedge clk ) begin
-            if (reset)  PC_I <= PROGRAM_ENTRY_ADR;
-            else        PC_I <= PCNext_I;
+            if (reset)                 PC_I <= PROGRAM_ENTRY_ADR;
+            else if (~External_MemStall) PC_I <= PCNext_I;
         end
     `endif
 
